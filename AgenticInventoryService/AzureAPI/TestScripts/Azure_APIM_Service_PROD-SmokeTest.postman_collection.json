									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Authorize",
								"value": "<string>",
								"disabled": true
							},
							{
								"key": "Accept",
								"value": "text/plain"
							},
							{
								"key": "Ocp-Apim-Subscription-Key",
								"value": "{{Corporate}}",
								"type": "default"
							}
						],
						"url": {
							"raw": "{{Url}}/health",
							"host": [
								"{{Url}}"
							],
							"path": [
